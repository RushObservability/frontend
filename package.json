{
  "name": "frontend",
  "private": true,
  "version": "0.1.6",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.13.1",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc -b",
    "validate:capacity-metrics": "node scripts/validate-capacity-metrics.mjs",
    "verify:opensource": "node scripts/verify-opensource-edition.mjs",
    "security:check": "node scripts/security-check.mjs",
    "security:headers": "node scripts/verify-security-headers.mjs",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@rushobservability/rum-sdk": "^0.2.0",
    "dompurify": "^3.4.14",
    "rrweb": "2.1.1",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "typescript": "npm:@typescript/typescript6@^6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
